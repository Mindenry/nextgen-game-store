# ============================================================================
# NEXTGEN GAME STORE — Environment Variables
# Copy to .env.local for development:  npm run env:init
# NEVER commit .env.local or real credentials.
# ============================================================================

# --- Application -----------------------------------------------------------
# Canonical URL used for OAuth redirects, QR return links and emails.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="NEXTGEN GAME STORE"
NODE_ENV="development"

# --- Database --------------------------------------------------------------
# Leave DATABASE_URL empty to use the embedded PGlite Postgres engine (dev only).
# Production: Supabase Postgres pooler connection string, e.g.
# postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=""
PGSSL="require"
POSTGRES_POOL_MAX="5"

# --- Supabase Auth / Storage (optional in local mode) ----------------------
# When these are set the app uses Supabase Auth (email + Google/Facebook/Discord OAuth)
# and Supabase Storage for uploads. See docs/OAUTH_SETUP.md.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="product-images"

# --- Encryption / signing --------------------------------------------------
# 32-byte base64 keys. Generate with: openssl rand -base64 32
ENCRYPTION_KEY="REPLACE_WITH_32_BYTE_BASE64_KEY"
CART_COOKIE_SECRET="REPLACE_WITH_RANDOM_STRING"

# --- Payments --------------------------------------------------------------
# PromptPay ID (mobile 0812345678 / national ID / e-wallet 15 digits)
# Can also be configured in Admin → Settings. Env takes precedence.
PROMPTPAY_ID=""
PROMPTPAY_RECEIVER_NAME="NEXTGEN GAME STORE"
# Generic webhook provider shared secret (HMAC-SHA256 of raw body in x-ngs-signature)
PAYMENT_WEBHOOK_SECRET=""
# Optional comma separated allow-list of webhook source IPs
PAYMENT_WEBHOOK_IP_ALLOWLIST=""
# Shared secret for /api/cron/reconcile (Vercel Cron or external scheduler)
CRON_SECRET=""
# KBank Open API credentials (leave empty until bank approval is complete)
KBANK_CLIENT_ID=""
KBANK_CLIENT_SECRET=""
KBANK_MERCHANT_ID=""
KBANK_ENV="sandbox"

# --- Email notifications ---------------------------------------------------
# Without a provider, development emails are written to .data/outbox/
RESEND_API_KEY=""
EMAIL_FROM="NEXTGEN GAME STORE <no-reply@example.com>"

# --- Test tooling ---------------------------------------------------------
# Local E2E only; NEVER enable in production.
E2E_BYPASS_RATE_LIMIT="false"

# --- Bootstrap -------------------------------------------------------------
# Development demo seed (catalogue, games, demo orders). NEVER enable in production.
SEED_DEMO="false"
BOOTSTRAP_ADMIN_EMAIL="admin@nextgen.local"
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME="Store Owner"
