{
  "name": "nextgen-game-store",
  "version": "1.0.0",
  "private": true,
  "description": "NEXTGEN GAME STORE - full-stack digital game store, top-up and wallet platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed-demo": "node scripts/seed-demo.mjs",
    "env:init": "node scripts/init-env.mjs",
    "check": "npm run typecheck && npm run test",
    "test:e2e:chrome": "playwright test --project=chrome",
    "db:test-product": "node scripts/create-test-product.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@hookform/resolvers": "5.2.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "framer-motion": "12.23.26",
    "jsqr": "^1.4.0",
    "lucide-react": "0.555.0",
    "next": "15.5.29",
    "pg": "8.16.3",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.66.1",
    "recharts": "3.10.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sonner": "2.0.8",
    "tailwind-merge": "3.4.0",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.29",
    "prettier": "3.7.4",
    "prettier-plugin-tailwindcss": "0.7.2",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vitest": "4.0.15"
  },
  "engines": {
    "node": ">=20.11"
  },
  "overrides": {
    "motion-dom": "12.23.23",
    "motion-utils": "12.23.6"
  }
}
